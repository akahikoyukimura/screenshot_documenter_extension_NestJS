{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["chrome"],
    "lib": ["ES2021", "DOM"],

    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}